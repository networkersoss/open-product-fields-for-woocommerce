#. Plugin Name of the plugin
#: open-product-fields-for-woocommerce.php
msgid "Open Product Fields for WooCommerce"
msgstr "Open Product Fields para WooCommerce"

#. Plugin URI of the plugin
#: open-product-fields-for-woocommerce.php
msgid "https://github.com/netwokersllc/open-product-fields-for-woocommerce"
msgstr "https://github.com/netwokersllc/open-product-fields-for-woocommerce"

#. Description of the plugin
#: open-product-fields-for-woocommerce.php
msgid ""
"Build custom product fields and add-ons for WooCommerce — conditional logic, "
"server-side pricing, and first-class block checkout support. Free and open "
"source."
msgstr "Crea campos de producto y complementos personalizados para WooCommerce: lógica condicional, precios calculados en el servidor y compatibilidad total con el pago por bloques. Gratuito y de código abierto."

#. Author of the plugin
#: open-product-fields-for-woocommerce.php
msgid "ssthormess"
msgstr "ssthormess"

#. Author URI of the plugin
